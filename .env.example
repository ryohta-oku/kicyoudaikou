# ローカル開発用 (SQLite)
DATABASE_URL="file:./dev.db"

# Turso (本番用クラウドDB - VPSで使用)
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token"

# Gemini API（OCR + 仕訳分類で選択可能）
# https://aistudio.google.com/apikey でAPIキーを取得
GEMINI_API_KEY="your-gemini-api-key"

# OpenAI API（OCR + 仕訳分類で選択可能。既定モデルが OpenAI のため必須）
# https://platform.openai.com/api-keys でAPIキーを取得
OPENAI_API_KEY="your-openai-api-key"

# 使用するAIモデル（任意）
# 優先順位: 管理画面の設定 > この環境変数 > 組み込みの既定値
# 指定できるIDは src/lib/ai/registry.ts の MODEL_CATALOG を参照
# OCR_MODEL="gpt-5.6-luna"
# CLASSIFY_MODEL="gpt-5.6-luna"

# --- 認証 ---

# NextAuth のシークレット。openssl rand -base64 32 などで生成する
AUTH_SECRET="your-auth-secret"

# 招待リンクなどに使う自分自身のURL
APP_URL="http://localhost:3000"

# 共通ログイン（認証を Client Hub に委ねる）。
# "on" のときだけ有効。それ以外の値・未設定なら従来どおりローカルの User で照合する。
#
# ログインは業務の玄関なので、切り替えて何かおかしければ VPS でこの行を消して
# pm2 restart するだけで戻せるようにしてある。
#
# on にすると、記帳代行側のアカウント操作（追加・パスワード変更・役割変更・削除）は
# 409 で断られる。効かない操作を「押せてしまう」状態を作らないため。
# アカウントは Client Hub の /users または顧客台帳から発行する。
#
# 役割は境界で写す:  admin → admin / staff → instructor / member → user_a
# SHARED_LOGIN="on"

# Client Hub の場所と、そこへ照合を投げるための共有キー。
# SHARED_LOGIN="on" のとき必須（未設定だとログインできない）
CLIENT_HUB_URL="http://localhost:3010"
CRM_API_KEY="client-hub と同じ値"

# 顧客台帳をアプリ別の範囲で読むための鍵。両方揃ったときだけ ?app= 経路に切り替わる
# CRM_APP_KEY="kicyoudaikou"
# CRM_CLIENTS_KEY="client-hub の CLIENTS_KEY_KICYOUDAIKOU と同じ値"
