# ローカル開発用 (SQLite)
DATABASE_URL="file:./dev.db"

# Turso (本番用クラウドDB - VPSで使用)
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token"

# Gemini API（OCR + 仕訳分類で選択可能）
# https://aistudio.google.com/apikey でAPIキーを取得
GEMINI_API_KEY="your-gemini-api-key"

# OpenAI API（OCR + 仕訳分類で選択可能。既定モデルが OpenAI のため必須）
# https://platform.openai.com/api-keys でAPIキーを取得
OPENAI_API_KEY="your-openai-api-key"

# 使用するAIモデル（任意）
# 優先順位: 管理画面の設定 > この環境変数 > 組み込みの既定値
# 指定できるIDは src/lib/ai/registry.ts の MODEL_CATALOG を参照
# OCR_MODEL="gpt-5.6-luna"
# CLASSIFY_MODEL="gpt-5.6-luna"
