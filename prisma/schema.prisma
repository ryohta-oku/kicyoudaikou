generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ユーザー（認証用）
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  plainPassword     String    @default("")
  name              String
  role              String    @default("user_b") // "admin", "instructor", "user_a", or "user_b"
  /// client-hub 側の User.id。**この行がどの共通アカウントのものかを固定する。**
  ///
  /// これが無いと、席（starNN.cocoboshi@gmail.com）を次の利用者へ引き継いだとき、
  /// 新しい方がログインした瞬間に**メール一致で前の方の行に吸い込まれる**。
  /// `Folder.firstCheckById` や `WorkLog.userId` が前の方を指したままになり、
  /// ダブルチェックの「作業者と確認者が別人か」の判定も、作業記録の名義も壊れる。
  ///
  /// 一度でも埋まった行は、以降メールでは引き当てない（src/lib/auth.ts）。
  /// null = 共通ログイン導入前からある行で、初回ログイン時に焼き付ける。
  hubUserId         String?   @unique
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 得意先（クライアント）
// ※ Prisma内部の "client" プロパティとの衝突を避けるため Company をモデル名として使用
model Company {
  id         String   @id @default(uuid())
  name       String
  isApproved Boolean  @default(false)
  createdBy  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// レシートの相手科目（貸方）の既定値。
  ///
  /// **弥生・マネーフォワード・freee のいずれも貸方勘定科目が必須**で、
  /// 空のままだと3社ともCSVを取り込めない。仕訳としても片側だけでは成立しない。
  /// 「現金で払った」が既定だが、カード払い中心の顧問先では「未払金」になる。
  /// 得意先ごとに違うので、ここに持つ。
  defaultCreditAccountCode String @default("1111")
  defaultCreditAccountName String @default("現金")

  /// 登録番号（インボイスのT番号）が無い領収書に付けるインボイス区分。
  ///
  /// **日付から自動判定しない。** 仕入税額控除の経過措置は割合の切り替わり日が
  /// 資料によって食い違う（マネーフォワードの案内は「70%控除＝2026年10月1日以降」、
  /// 一般に知られている法令上の区分は「2026年10月1日から50%」）。
  /// アプリが日付で決めると、どちらが正しくても黙って間違える側になる。
  /// 設定値として画面に見える形にしておき、税理士に確認して直せるようにする。
  ///
  /// 空欄にしないのはマネーフォワードが空欄を「適格」とみなすため
  /// （免税事業者の領収書が適格扱いになってしまう）。
  /// 値: "適格" / "80%控除" / "70%控除" / "50%控除" / "30%控除" / "控除なし"
  nonQualifiedInvoiceKind String @default("80%控除")

  folders        Folder[]
  subAccounts    SubAccount[]
  advisorClients AdvisorClient[]

  @@map("Client")
}

/// 税理士（社外）が見てよい得意先。
///
/// **行が無い得意先は、その税理士には存在しないものとして扱う。**
/// 得意先の絞り込みはこれまで localStorage の `selectedClientId` だけで、
/// サーバー側には無かった。社内の人しか居ない間は成立していたが、
/// 社外の人を入れる以上、クエリの clientId を信用してはいけない。
///
/// `userId` に FK を張らないのは `WorkSession.userId` 等と同じ理由 ――
/// 共通ログインのとき `User` は「影」で、id を保ったまま役割と氏名だけ同期される。
model AdvisorClient {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  createdBy String   @default("")
  createdAt DateTime @default(now())

  client Company @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
}

// フォルダ（アップロード時にファイルをグループ化）
model Folder {
  id        String   @id @default(uuid())
  name      String
  creator   String   @default("")
  clientId       String?
  handoffStatus  String?            // null=未引継, "handed_off"=引継済
  handoffBy      String   @default("") // 引き継いだB型ユーザー名
  handoffAt      DateTime?          // 引き継ぎ日時

  // ダブルチェック関連
  doubleCheckStatus  String?              // null | "pending" | "completed"
  firstCheckById     String   @default("") // 1stチェック者のユーザーID
  firstCheckByName   String   @default("") // 1stチェック者の表示名
  firstCheckAt       DateTime?
  doubleCheckById    String   @default("") // 2ndチェック者のユーザーID
  doubleCheckByName  String   @default("") // 2ndチェック者の表示名
  doubleCheckAt      DateTime?
  needsDoubleCheck   Boolean  @default(false) // A型がダブルチェック必要（B型1人パターン）

  /// 税理士の最終チェック。
  /// null（依頼していない）/ "pending"（依頼中）/ "returned"（差し戻し）/ "approved"（OK）
  taxReviewStatus   String?
  taxReviewedBy     String    @default("")
  taxReviewedByName String    @default("")
  taxReviewedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client    Company?   @relation(fields: [clientId], references: [id])
  documents Document[]
}

// アップロードされたドキュメント
model Document {
  id         String   @id @default(uuid())
  folderId   String?
  filename   String
  filepath   String
  fileType   String   @default("pdf") // pdf, jpeg, png, webp, etc.
  fileData   Bytes?   // アップロードファイルのバイナリデータ（Vercel用）
  title      String   @default("") // ドキュメントタイトル
  creator    String   @default("") // 作成者
  status     String   @default("uploaded") // uploaded, ocr_processing, ocr_complete, ocr_confirmed, classified, reviewed, exported
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  folder           Folder?            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  pages            DocumentPage[]
  journalEntries   JournalEntry[]
  deletionRequests DeletionRequest[]
}

// ドキュメントの各ページ
model DocumentPage {
  id            String  @id @default(uuid())
  documentId    String
  pageNumber    Int
  imagePath     String  // レンダリングされたページ画像のパス
  imageData     Bytes?  // ページ画像のバイナリデータ（Vercel用）
  ocrText       String  @default("") // OCRで読み取ったテキスト
  correctedText String  @default("") // ユーザーが修正したテキスト
  isConfirmed   Boolean @default(false)

  // 構造化フィールド（AIで抽出）
  date               String @default("") // 日付
  registrationNumber String @default("") // 適格請求書発行事業者登録番号（T始まり）

  /// レシート番号（No. / 取引番号 / 伝票番号）。**その1回の取引を指す番号。**
  ///
  /// 重複の判定にだけ使う。帳簿にもCSVにも出さない。
  ///
  /// 登録番号（T番号）とは役割が違う ―― T番号は同じ店なら全部同じなので
  /// 単独では重複を判定できない。レシート番号は取引ごとに変わるので、
  /// **番号が違えば別の取引だと機械で言える**。
  /// 「同じ日に同じ店で同じ額を2回買った」という誤検知が、これで消える。
  ///
  /// 読み取れないことがある（手書きの領収書には番号が無い、かすれて読めない）。
  /// **空でも確認は止めない** ―― これは手がかりであって、帳簿の中身ではない。
  receiptNumber String @default("")
  amount             String @default("") // 金額（税込）
  tax                String @default("") // 消費税
  memo               String @default("") // メモ

  /// 税率ごとの内訳（JSON配列）。軽減税率8%と標準税率10%が1枚に混ざるレシート用。
  ///
  /// 内訳を持たないと全額が片方の税率で記帳され、消費税額が合わなくなる
  /// （税込1,302円・消費税112円の領収書を全額10%とすると118円になる）。
  ///
  /// 形: [{"rate":"8","amount":"378","tax":"28","items":"お茶、おにぎり"}, ...]
  /// 税率が1種類だけの書類では空のまま（分ける意味が無いため）。
  taxLines String @default("")

  /// この領収書に登録番号が「元から無い」ことを人が確認した印。
  /// 免税事業者や手書きの領収書では番号が存在しないため、これが無いと
  /// 登録番号のチェックが通らず確認完了できなかった。
  /// registrationNumber が空なだけの状態（＝読み取れなかっただけかもしれない）と
  /// 区別できるようにフラグで持つ。ダブルチェックする人が探し直さずに済む。
  noRegistrationNumber Boolean @default(false)

  // ダブルチェック
  isDoubleChecked    Boolean @default(false)

  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  snapshot       PageSnapshot?

  @@unique([documentId, pageNumber])
}

// 1stチェック時の値スナップショット（ダブルチェック用）
model PageSnapshot {
  id                 String   @id @default(uuid())
  pageId             String   @unique
  userId             String
  userName           String   @default("")
  date               String   @default("")
  registrationNumber String   @default("")
  amount             String   @default("")
  tax                String   @default("")
  memo               String   @default("")
  createdAt          DateTime @default(now())

  page               DocumentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// 仕訳データ
model JournalEntry {
  id              String   @id @default(uuid())
  documentId      String
  pageId          String?
  date            String   // 取引日 (YYYY-MM-DD)
  description     String   // 摘要
  accountCode     String   @default("") // 勘定科目コード
  accountName     String   @default("") // 勘定科目名
  subAccountCode  String   @default("") // 補助科目コード
  subAccountName  String   @default("") // 補助科目名
  debitAmount     Int      @default(0)  // 借方金額
  creditAmount    Int      @default(0)  // 貸方金額
  taxRate         String   @default("") // 税率区分

  /// 相手科目（この仕訳の反対側）。空なら得意先の既定値を使う。
  /// 同じ得意先でも「この1枚だけカード払い」があるので、仕訳ごとに上書きできる。
  creditAccountCode String @default("")
  creditAccountName String @default("")
  aiSuggested     Boolean  @default(false) // AI推測かどうか
  aiReasoning     String   @default("") // AIによる勘定科目選定理由
  isConfirmed     Boolean  @default(false) // 確認済みかどうか
  duplicateDismissed Boolean @default(false) // 重複検知を却下済みかどうか
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page             DocumentPage?      @relation(fields: [pageId], references: [id])
  deletionRequests DeletionRequest[]
  taxReview        TaxReview?
  revisions        EntryRevision[]
}

/// 税理士がその場で直した記録。
///
/// **社外の人が帳簿を書き換えるので、何を誰がいつ変えたかを必ず残す。**
/// 記録が無いと、あとで数字が違ったときに「元がこうだったのか、直したのか」が
/// 分からなくなる。税理士の最終チェックは、その記録にこそ意味がある工程。
///
/// 事業所側にも見せる。利用者さんが「ここはこうするんだ」と学べるようにするのが
/// いちばん大きい ―― 次から同じ間違いが減る。
model EntryRevision {
  id      String @id @default(uuid())
  entryId String

  changedBy     String @default("")
  changedByName String @default("")
  /// "tax_advisor"（本物の税理士）/ "office_as_advisor"（事業所の人が税理士として）
  changedByKind String @default("tax_advisor")

  /// 変わった項目だけをJSONで持つ。
  /// 形: [{"field":"accountName","label":"勘定科目","before":"会議費","after":"福利厚生費"}]
  /// 全項目を持たないのは、あとで見るときに「何が変わったか」だけが要るため。
  changes String @default("")

  createdAt DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

/// 税理士による1仕訳ごとの確認。
///
/// **誰がどの立場で押したかを両方持つ。** 事業所の人が「税理士として操作」した
/// ものと、本物の税理士が押したものを後から区別できないと、
/// 「誰が承認したか」の記録が意味を失う。税理士の最終チェックは、
/// その記録にこそ意味がある工程。
model TaxReview {
  id      String @id @default(uuid())
  entryId String @unique

  /// "ok"（このままでよい）/ "needs_fix"（直してほしい）
  status  String
  /// "needs_fix" のときに何が違うのかを書く
  comment String @default("")

  reviewedBy     String @default("")
  reviewedByName String @default("")
  /// "tax_advisor"（本物の税理士）/ "office_as_advisor"（事業所の人が税理士として）
  reviewerKind   String @default("tax_advisor")

  reviewedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

// 作業セッション（全体時間を管理）
model WorkSession {
  id            String    @id @default(uuid())
  userId        String
  userName      String    @default("")
  userRole      String    @default("")
  folderId      String?
  folderName    String    @default("")
  status        String    @default("active")  // "active", "completed"
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  totalSec      Int       @default(0)
  documentCount Int       @default(0)
  workLogs      WorkLog[]
}

// 各工程の詳細ログ
model WorkLog {
  id          String       @id @default(uuid())
  sessionId   String?
  session     WorkSession? @relation(fields: [sessionId], references: [id])
  userId      String
  userName    String       @default("")
  userRole    String       @default("")
  folderId    String?
  folderName  String       @default("")
  documentId  String?
  action      String       // "work_session", "upload", "ocr_confirm", "handoff", "classify_complete", "entry_confirm", "export"
  workType    String       // "preparation", "ocr_review", "classify", "review", "export", "upload", "handoff"
  durationSec Int          @default(0)
  createdAt   DateTime     @default(now())
}

// 勘定科目マスター
model Account {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  category    String       // 資産, 負債, 純資産, 収益, 費用
  subAccounts SubAccount[]
}

// 補助科目マスター
model SubAccount {
  id         String  @id @default(uuid())
  accountId  String
  code       String
  name       String
  clientId   String?
  isApproved Boolean @default(false)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client  Company? @relation(fields: [clientId], references: [id])

  @@unique([accountId, code, clientId])
}

// 削除依頼（仮削除→承認フロー）
model DeletionRequest {
  id          String   @id @default(uuid())
  entryId     String
  documentId  String
  reason      String   @default("duplicate")
  requestedBy String   @default("")
  status      String   @default("pending") // "pending", "approved", "rejected"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  document Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// アプリ設定（キー・バリュー）
// 現在のキー: "ai.ocrModel", "ai.classifyModel"
model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
