# ===========================================
# 本番環境用 .env ファイル テンプレート
# ===========================================
# VPS の /var/www/kicyoudaikou/.env にコピーして値を設定してください
# cp .env.production.example .env

# --- データベース ---
# ローカルSQLite（VPS本番用）
DATABASE_URL="file:./prisma/production.db"

# Turso クラウドDB（使う場合はこちらを設定）
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Gemini API（OCR + 仕訳分類で選択可能） ---
GEMINI_API_KEY="your-gemini-api-key"

# --- OpenAI API（OCR + 仕訳分類で選択可能。既定モデルが OpenAI のため必須） ---
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# --- 使用するAIモデル（任意） ---
# 優先順位: 管理画面の設定 > この環境変数 > 組み込みの既定値
# 指定できるIDは src/lib/ai/registry.ts の MODEL_CATALOG を参照
# OCR_MODEL="gpt-5.6-luna"
# CLASSIFY_MODEL="gpt-5.6-luna"

# --- アプリ設定 ---
NODE_ENV="production"
PORT=3000
